# Copy to .env and fill in. Never commit .env.
# Variables are added by the modules that introduce them (see docs/PROGRESS.md).

# --- Postgres / TimescaleDB (M0.3) ---
POSTGRES_USER=jarvis
# CHANGE THIS. The setup script (M7.x) will generate one for you.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jarvis

# --- Secrets (M1.2) ---
# Master key that encrypts stored API credentials: 32 random bytes, standard base64.
# Generate with: openssl rand -base64 32
# Leave blank here; the setup script (M7.x) will generate one for you.
# The api refuses to start without it. See docs/secrets-rotation.md.
JARVIS_MASTER_KEY=
# Only while rotating the key with `jarvis rotate-master-key`; remove afterwards.
# JARVIS_NEW_MASTER_KEY=

# --- Management API (M1.3) ---
# Bearer token for /api/v1 and /openapi.json: at least 32 characters.
# Generate with: openssl rand -hex 32
# Leave blank here; the setup script (M7.x) will generate one for you. The api refuses to start without it.
JARVIS_ADMIN_TOKEN=

# --- Gateway (M0.3) ---
# Number of gateway replicas started by compose.
GATEWAY_REPLICAS=1

# --- Gateway config loader (M1.4) ---
# The gateway loads API policies and key hashes from Postgres at startup, keeps them current
# through Redis events, and does a full resync on this interval (seconds, minimum 1).
# JARVIS_RESYNC_INTERVAL_S=60
# Where it keeps the last loaded config so it can start while Postgres is down. The compose
# file mounts the gateway-snapshot volume at /var/lib/jarvis/gateway.
# JARVIS_SNAPSHOT_PATH=/var/lib/jarvis/gateway/snapshot.json

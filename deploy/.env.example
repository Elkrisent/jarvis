# Copy to .env and fill in. Never commit .env.
# Variables are added by the modules that introduce them (see docs/PROGRESS.md).

# --- Postgres / TimescaleDB (M0.3) ---
POSTGRES_USER=jarvis
# CHANGE THIS. The setup script (M7.x) will generate one for you.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jarvis

# --- Secrets (M1.2) ---
# Master key that encrypts stored API credentials: 32 random bytes, standard base64.
# Generate with: openssl rand -base64 32
# Leave blank here; the setup script (M7.x) will generate one for you.
# The api refuses to start without it. See docs/secrets-rotation.md.
JARVIS_MASTER_KEY=
# Only while rotating the key with `jarvis rotate-master-key`; remove afterwards.
# JARVIS_NEW_MASTER_KEY=

# --- Management API (M1.3) ---
# Bearer token for /api/v1 and /openapi.json: at least 32 characters.
# Generate with: openssl rand -hex 32
# Leave blank here; the setup script (M7.x) will generate one for you. The api refuses to start without it.
JARVIS_ADMIN_TOKEN=

# --- Gateway (M0.3) ---
# Number of gateway replicas started by compose.
GATEWAY_REPLICAS=1

# --- Gateway config loader (M1.4) ---
# The gateway loads API policies and key hashes from Postgres at startup, keeps them current
# through Redis events, and does a full resync on this interval (seconds, minimum 1).
# JARVIS_RESYNC_INTERVAL_S=60
# Where it keeps the last loaded config so it can start while Postgres is down. The compose
# file mounts the gateway-snapshot volume at /var/lib/jarvis/gateway.
# JARVIS_SNAPSHOT_PATH=/var/lib/jarvis/gateway/snapshot.json
# A gateway that cannot reach Postgres at startup serves the snapshot file only if it was synced
# at most this many seconds ago (default 86400 = 24 h, minimum 1). An older file is ignored and the
# gateway stays not ready until Postgres is back, because keys revoked since then would still work.
# JARVIS_SNAPSHOT_MAX_AGE_S=86400

# --- Upstream destinations (SSRF guard, M1.7) ---
# By default JARVIS refuses upstreams that are loopback, private (RFC 1918), link-local (including
# 169.254.169.254), CGNAT, IPv6 ULA/link-local, multicast or the JARVIS containers, and refuses
# plain http. List extra permitted internal upstreams here: CIDRs and/or host names separated by
# commas or spaces. A listed host may use plain http and may resolve to a private address; a listed
# CIDR permits names that resolve into it. The JARVIS containers stay blocked even if covered, and
# so do loopback and 0.0.0.0 unless an entry lies inside them (127.0.0.0/8, ::1/128): a catch-all
# such as 0.0.0.0/0 never opens the gateway's own listeners.
# Read by the api when an API is saved, and by the gateway for every upstream connection.
# JARVIS_SSRF_ALLOWLIST=10.20.0.0/16 partner.internal
# Names of the JARVIS containers that must never be reachable as upstreams. Setting this replaces
# the default list, so include every container name.
# JARVIS_INTERNAL_HOSTS=gateway,api,worker,postgres,redis

# Largest request body the gateway forwards, in bytes (default 10485760 = 10 MB). Larger bodies get
# 413 JV_BODY_TOO_LARGE.
# JARVIS_MAX_BODY_BYTES=10485760

# Telemetry (SPEC 6.1, 6.3): the gateway writes one event per request to the Redis Stream
# `telemetry` without ever waiting for it. Events wait in a bounded in-memory queue and are sent in
# batches; if the queue is full or Redis is unavailable they are dropped and counted (see
# `telemetry.dropped_total` in the gateway's /readyz). Changing these needs a gateway restart.
# JARVIS_TELEMETRY_ENABLED=true
# JARVIS_TELEMETRY_QUEUE_SIZE=10000
# JARVIS_TELEMETRY_BATCH_SIZE=500
# JARVIS_TELEMETRY_STREAM_MAXLEN=1000000

# Rate limits (SPEC 4.11): how many gateway instances share each limit. Only used when Redis is
# unreachable: each instance then enforces its own bucket of `limit / JARVIS_EXPECTED_INSTANCES`.
# JARVIS_EXPECTED_INSTANCES=1
